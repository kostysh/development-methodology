{
  "name": "@kostysh/development-methodology-tools",
  "version": "5.3.2",
  "private": true,
  "description": "Project-local process metrics, decision gates, verification and integration tools",
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "bin": {
    "methodology-baseline": "./dist/baseline.js",
    "methodology-check-links": "./dist/check-links.js",
    "methodology-controls": "./dist/controls.js",
    "methodology-metrics": "./dist/metrics.js",
    "methodology-recovery": "./dist/recovery.js",
    "methodology-solo": "./dist/solo.js",
    "methodology-task": "./dist/task.js",
    "methodology-train": "./dist/train.js"
  },
  "files": [
    "dist/",
    "assets/"
  ],
  "scripts": {
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc --project tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "test:packed": "node --test test/package.packed.ts",
    "check:links": "node dist/check-links.js"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "parse5": "8.1.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "bundledDependencies": [
    "github-slugger",
    "markdown-it",
    "parse5"
  ]
}
